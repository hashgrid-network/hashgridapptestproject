rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Remote Over-the-air update & app configs
    match /app_config/{document=**} {
      allow read, write: if true;
    }

    // Wallets & nested collections (rigs, withdrawals, deposits, referral_rewards, referral_list)
    match /wallets/{walletId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // User accounts & nested collections (grid_contracts, miners, transactions, referral_rewards, notifications, team)
    match /users/{userId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Anti-Fraud Device Registry
    match /device_registry/{deviceIdHash} {
      allow read, write: if true;
    }

    // Bounty, Social & Syndicate Task Claims
    match /task_claims/{claimId} {
      allow read, write: if true;
    }

    match /task_submissions/{submissionId} {
      allow read, write: if true;
    }

    // Withdrawals and deposits queue
    match /withdrawals/{requestId} {
      allow read, write: if true;
    }

    match /deposits/{depositId} {
      allow read, write: if true;
    }

    match /processed_deposits/{txId} {
      allow read, write: if true;
    }

    // System ping and sync
    match /_system_time/{docId} {
      allow read, write: if true;
    }
  }
}
